null,"outputs":[]},{"cell_type":"markdown","source":["The **CYCLING** cell runs the previous functions on all datasets and compares them."],"metadata":{"id":"X4APuqBQ8MIu"}},{"cell_type":"code","source":["\n","import gc\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","def compare_datasets(summaries, author_sets):\n","    global FIG_DIR, _FIG_N\n","\n","    cdir = OUT_DIR / \"datasets_comparison\"\n","    cdir.mkdir(parents=True, exist_ok=True)\n","    FIG_DIR, _FIG_N = cdir, 0\n","\n","    # --------------------------------------------------------\n","    # DATASET SUMMARY\n","    # --------------------------------------------------------\n","\n","    comp = pd.DataFrame(summaries).set_index(\"dataset\")\n","\n","    comp.round(3).to_csv(\n","        cdir / \"datasets_recap.csv\",\n","        encoding=\"utf-8-sig\"\n","    )\n","\n","    print(comp.round(2).T.to_string())\n","\n","    gc.collect()\n","\n","    # --------------------------------------------------------\n","    # COMPARISON PLOTS\n","    # --------------------------------------------------------\n","\n","    panels = [\n","        (\"n_authors\", \"N. authors\"),\n","        (\"n_mbti_valid\", \"N. authors with MBTI type\"),\n","        (\"n_big5_complete\", \"N. authors with all Big Five traits\"),\n","        (\"n_comments_total\", \"Total number of comments\"),\n","        (\"median_comments\", \"Median of comments per author\"),\n","        (\"pct_female\", \"Women percentage\"),\n","        (\"mean_age\", \"Average age\"),\n","        (\"n_subreddits\", \"Different subreddits count\"),\n","        (\"pct_comments_personality_subs\", \"Percentage of possible leakage comments\")\n","    ]\n","\n","    panels = [\n","        (c, t) for c, t in panels\n","        if c in comp.columns\n","        and comp[c].notna().any()\n","        and (comp[c] != 0).any()\n","    ]\n","\n","    if panels:\n","        nc = 3\n","        nr = int(np.ceil(len(panels) / nc))\n","\n","        fig, axes = plt.subplots(\n","            nr,\n","            nc,\n","            figsize=(4.4 * nc, 3.6 * nr),\n","            squeeze=False\n","        )\n","\n","        for ax, (c, t) in zip(axes.ravel(), panels):\n","            bars = ax.bar(comp.index, comp[c], edgecolor=\"white\")\n","\n","            ax.bar_label(\n","                bars,\n","                labels=[\n","                    f\"{v:,.1f}\" if abs(v) < 1000 else f\"{v:,.0f}\"\n","                    for v in comp[c]\n","                ],\n","                padding=2,\n","                fontsize=8\n","            )\n","\n","            ax.set_title(t, fontsize=10)\n","\n","            # Free temporary objects after each panel\n","            del bars\n","            gc.collect()\n","\n","        for ax in axes.ravel()[len(panels):]:\n","            ax.axis(\"off\")\n","\n","        savefig(\"datasets_comparison\")\n","\n","        plt.close(fig)\n","        del fig, axes\n","        gc.collect()\n","\n","    # --------------------------------------------------------\n","    # AUTHOR OVERLAP\n","    # --------------------------------------------------------\n","\n","    names = [n for n, a in author_sets.items() if a]\n","\n","    if len(names) >= 2:\n","        print(\"\\nCalculating author overlap...\")\n","\n","        # Build overlap matrix\n","        overlap_data = []\n","\n","        for a in names:\n","            row = []\n","\n","            for b in names:\n","                row.append(len(author_sets[a] & author_sets[b]))\n","\n","            overlap_data.append(row)\n","\n","            # Free temporary objects after each row\n","            del row\n","            gc.collect()\n","\n","        ov = pd.DataFrame(\n","            overlap_data,\n","            index=names,\n","            columns=names\n","        )\n","\n","        ov.to_csv(\n","            cdir / \"authors_overlap.csv\",\n","            encoding=\"utf-8-sig\"\n","        )\n","\n","        print(\"\\nAuthors Overlap:\\n\", ov.to_string())\n","\n","        heatmap(\n","            ov,\n","            \"authors_overlap\",\n","            \"Common authors\",\n","            fmt=\"{:,.0f}\",\n","            cmap=\"Blues\",\n","            cbar_label=\"Number of authors\",\n","            figsize=(5.5, 4.5)\n","        )\n","\n","        # Free overlap-related objects\n","        del ov, overlap_data\n","        gc.collect()\n","\n","    # --------------------------------------------------------\n","    # FINAL MEMORY CLEANUP\n","    # --------------------------------------------------------\n","\n","    del comp, panels, names\n","    gc.collect()\n","\n","    print(\"\\nDataset comparison completed.\")\n","    print(f\"Results saved in: {cdir}\")"],"metadata":{"id":"sXPKTSe0weSe"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["summaries, author_sets = [], {}\n","for ds_name, ds_path in DATASETS.items():\n","    if not Path(ds_path).exists():\n","        print(f\"!! File not found: {ds_path}\")\n","        continue\n","    s, a = run_analysis(ds_name, Path(ds_path))\n","    summaries.append(s)\n","    author_sets[ds_name] = a\n","    gc.collect()\n","\n","if summaries:\n","    compare_datasets(summaries, author_sets)\n","print(\"\\nOutput saved in:\", OUT_DIR)\n"],"metadata":{"id":"ehM2zOpwwYmU","colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1l6hav5oI-7cPIgLnhlCBO0v5RjDcYMaO"},"executionInfo":{"status":"ok","timestamp":1791387046771,"user_tz":-120,"elapsed":343845,"user":{"displayName":"Elena Maggiore","userId":"11614094448871357718"}},"outputId":"7377a542-ce53-4362-decf-4798d7edb491"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}]}]}